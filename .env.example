# Copy to .env.local for local development; on Vercel add each of these under Project Settings > Environment Variables.
# Never commit real values.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# The code reads STRIPE_PRICE_PRO_MONTHLY / STRIPE_PRICE_PRO_YEARLY; the *_ID_* names below are accepted as aliases.
STRIPE_PRICE_ID_PRO_MONTHLY=
STRIPE_PRICE_ID_PRO_YEARLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
# Needed by /api/webhook to verify Stripe events
STRIPE_WEBHOOK_SECRET=

THE_ODDS_API_KEY=
ODDSPAPI_KEY=
BALLDONTLIE_API_KEY=
OPENWEATHERMAP_API_KEY=

# Analytics and error monitoring (leave empty or "placeholder" to switch them off)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
NEXT_PUBLIC_SENTRY_DSN=
